# Copy this file to `.env` and fill in your key. `.env` is git-ignored.

# NVIDIA NIM API key (get one at https://build.nvidia.com). Leave empty to run
# in offline mode, where a rule-based planner replaces the LLM.
NVIDIA_API_KEY=

# Any chat model hosted on https://integrate.api.nvidia.com
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Server
PORT=3000
# Max requests per IP per minute on /api/*
RATE_LIMIT_PER_MINUTE=30
# Upstream timeout in milliseconds (LLM + air-quality provider)
REQUEST_TIMEOUT_MS=30000
# Set to "false" if your chosen model rejects the `enable_thinking` option.
NVIDIA_DISABLE_THINKING=true
# Backup models tried in order if the primary fails (comma-separated). Empty = no backups.
# A failed model is skipped for 60 s. If every model fails, built-in guidance is shown.
NVIDIA_FALLBACK_MODELS=nvidia/nemotron-3.5-bolt-e4b,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
# Tighter per-IP limit for the AI endpoints (/api/plan, /api/chat)
AI_RATE_LIMIT_PER_MINUTE=12
# Total time all AI models together may use per request (ms). Keep it below your host's function limit.
# Netlify free plan (10 s limit): use 6000 together with REQUEST_TIMEOUT_MS=4000.
AI_TOTAL_TIMEOUT_MS=20000
