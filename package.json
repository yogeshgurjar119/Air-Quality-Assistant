{
  "name": "airwise",
  "version": "1.0.0",
  "description": "GenAI assistant that turns live air-quality data into low-emission daily routines for families.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --watch --env-file-if-exists=.env server/index.js",
    "lint": "eslint .",
    "test": "node --test \"tests/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=90 --test-coverage-functions=85 \"tests/*.test.js\"",
    "check": "npm run format:check && npm run lint && npm test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "compression": "^1.8.2",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "serverless-http": "^3.2.0"
  },
  "license": "MPL-2.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "axe-core": "^4.14.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "puppeteer-core": "^25.18.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yogeshgurjar119/Air-Quality-Assistant.git"
  },
  "homepage": "https://air-wise.netlify.app/",
  "bugs": {
    "url": "https://github.com/yogeshgurjar119/Air-Quality-Assistant/issues"
  },
  "author": "Yogesh Gurjar",
  "keywords": [
    "air-quality",
    "genai",
    "accessibility",
    "express"
  ]
}
